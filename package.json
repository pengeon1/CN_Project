{
  "name": "cn-whiteboard-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LAN-based, multi-user, real-time collaborative whiteboard",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "server": "npm --workspace=@cn-whiteboard/server run dev",
    "client": "npm --workspace=@cn-whiteboard/client run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:server": "node scripts/package-server.mjs",
    "package:client": "npm --workspace=@cn-whiteboard/client run package",
    "package:all": "npm run package:server && npm run package:client",
    "smoke:server": "node scripts/smoke-server-binary.mjs",
    "docs:pdf": "node scripts/generate-docs-pdf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.6",
    "@yao-pkg/pkg": "^6.5.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^14.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
