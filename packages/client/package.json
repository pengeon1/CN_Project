{
  "name": "@cn-whiteboard/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "dev:electron": "npm run build:electron && electron dist-electron/main.cjs",
    "dev": "concurrently -k -s first \"npm run dev:vite\" \"wait-on http://127.0.0.1:5173 && npm run dev:electron\"",
    "build:vite": "tsc --noEmit && vite build",
    "build": "npm run build:vite && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@cn-whiteboard/common": "*",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "45.2.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "lucide-react": "^0.460.0",
    "perfect-freehand": "^1.2.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.1"
  },
  "description": "CS3004 Computer Networks Practice — LAN collaborative whiteboard desktop client",
  "author": "CS3004 CN Whiteboard Project Team"
}
