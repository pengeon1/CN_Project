{
  "name": "@cn-whiteboard/server",
  "version": "1.0.3",
  "private": true,
  "description": "CS3004 Computer Networks Practice — Standalone TCP/UDP LAN collaborative whiteboard server",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js && npm run build:cli",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/whiteboard-server.cjs"
  },
  "dependencies": {
    "@cn-whiteboard/common": "*"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
