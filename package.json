{
  "name": "cn-whiteboard-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "LAN-based, multi-user, real-time collaborative whiteboard",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "server": "npm --workspace=@cn-whiteboard/server run dev",
    "client": "npm --workspace=@cn-whiteboard/client run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.6",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
